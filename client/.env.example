# StudyBuddy Client Environment Variables (Member D Modules)

# Set to 'true' to run fully offline against the mock data module (ideal for preview and testing).
# Set to 'false' to connect to the Express backend API endpoints.
VITE_USE_MOCK=true

# API Base URL (defaults to /api with local Vite proxy to port 5001 or production backend)
VITE_API_URL=/api

